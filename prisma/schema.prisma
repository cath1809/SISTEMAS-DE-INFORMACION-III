generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Definimos los roles permitidos
enum Role {
  USER   // Representa al estudiante o usuario normal
  ADMIN  // Representa al administrador
}

model User {
  id         String               @id @default(uuid())
  name       String
  email      String               @unique
  cedula     String               @unique // <-- Nuevo campo agregado como obligatorio y único
  password   String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  tokens     PasswordResetToken[]
  progress   ModuleProgress[] // Nueva relación
  // 2. Agregamos el campo de rol con el valor por defecto
  role       Role                 @default(USER)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  code      String   @unique // Aquí se guardará el código de 6 dígitos (ej. "529413")
  expiresAt DateTime // Tiempo de expiración corto (10 minutos)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModuleProgress {
  id          String   @id @default(uuid())
  moduleId    Int      // Para saber si es el módulo 1, 2, 3 o 4
  progressPct Int      @default(0) // Porcentaje del 0 al 100
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Esta regla evita que un usuario tenga dos progresos duplicados para el mismo módulo
  @@unique([userId, moduleId]) 
}